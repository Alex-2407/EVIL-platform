# ==================== ENVIRONMENT CONFIGURATION ====================
# Copia questo file in .env e configura i tuoi valori

# ==================== SERVER ====================
NODE_ENV=development
PORT=5000
BASE_URL=http://localhost:5000

# ==================== DATABASE ====================
DB_FILE=./users.json

# ==================== JWT SECURITY ====================
JWT_SECRET=your_super_secret_key_change_this_in_production_minimum_32_chars
JWT_SECRET_REFRESH=your_refresh_secret_key_change_this_in_production_min_32_chars
ACCESS_TOKEN_EXPIRY=1h
REFRESH_TOKEN_EXPIRY=7d

# ==================== BCRYPT ====================
BCRYPT_ROUNDS=12

# ==================== SECURITY ====================
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=1800000  # 30 minutes in milliseconds

# ==================== REDIS (for token management) ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ==================== EMAIL CONFIGURATION ====================
# === Option 1: MAILTRAP (Recommended for Testing) ===
# 1. Sign up at https://mailtrap.io (free tier available)
# 2. Copy your credentials from Mailtrap dashboard
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_mailtrap_username
SMTP_PASS=your_mailtrap_password
SMTP_FROM_EMAIL=noreply@evil-platform.com
SMTP_SECURE=false

# === Option 2: GMAIL ===
# 1. Enable 2FA on your Gmail account
# 2. Generate App Password at https://myaccount.google.com/apppasswords
# 3. Use app password instead of regular password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM_EMAIL=your-email@gmail.com
# SMTP_SECURE=true

# === Option 3: SendGrid ===
# 1. Sign up at https://sendgrid.com
# 2. Create API key from Settings > API Keys
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your_sendgrid_api_key
# SMTP_FROM_EMAIL=your-email@example.com
# SMTP_SECURE=false

# === Option 4: Generic SMTP Server ===
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_USER=your_username
# SMTP_PASS=your_password
# SMTP_FROM_EMAIL=noreply@your-domain.com
# SMTP_SECURE=false

# ==================== LOGGING ====================
LOG_LEVEL=info
LOG_FILE=./logs/app.log
AUDIT_LOG_FILE=./logs/audit.log

# ==================== API RATE LIMITING ====================
RATE_LIMIT_WINDOW_MS=900000   # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# ==================== CORS ====================
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,https://www.projectevil.it,https://projectevil.it

# ==================== FILE UPLOAD ====================
MAX_UPLOAD_SIZE=10485760  # 10 MB in bytes
UPLOAD_DIR=./uploads

# ==================== SECURITY FEATURES ====================
HELMET_ENABLED=true
COMPRESSION_ENABLED=true

# ==================== ADMIN ====================
ADMIN_EMAIL=admin@evil-platform.com
ADMIN_PASSWORD=change_this_secure_password
