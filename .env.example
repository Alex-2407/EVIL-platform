# ==================== ENVIRONMENT CONFIGURATION ====================
# Copia questo file in .env e configura i tuoi valori

# ==================== SERVER ====================
NODE_ENV=development
PORT=5000
BASE_URL=http://localhost:5000

# ==================== DATABASE ====================
DB_FILE=./users.json
# Render: volume persistente es. DATA_DIR=/data
DATA_DIR=

# ==================== HELP / SUPPORT ====================
HELP_SUPPORT_EMAIL=support@projectevil.it

# ==================== JWT SECURITY ====================
JWT_SECRET=your_super_secret_key_change_this_in_production_minimum_32_chars
JWT_SECRET_REFRESH=your_refresh_secret_key_change_this_in_production_min_32_chars
JWT_ACCESS_EXPIRY=1h
JWT_REFRESH_EXPIRY=7d

# ==================== BCRYPT ====================
BCRYPT_ROUNDS=12

# ==================== SECURITY ====================
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=1800000  # 30 minutes in milliseconds

# ==================== REDIS (for token management) ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ==================== EMAIL CONFIGURATION ====================
# Per ricevere email nella TUA casella (Gmail, ecc.): usa Gmail o Mailtrap LIVE (live.smtp.mailtrap.io)
# Mailtrap SANDBOX: le email NON arrivano in Gmail — solo su https://mailtrap.io/sandboxes
#
# --- Mailtrap Sandbox (solo test, inbox su mailtrap.io) ---
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=incolla_username_da_mailtrap_sandboxes
SMTP_PASS=incolla_password_da_mailtrap_sandboxes
SMTP_FROM_EMAIL=noreply@evil-platform.com
SMTP_SECURE=false
SMTP_MODE=sandbox
# Logo nelle email: di default allegato dal file html/generated-image.png (non usare localhost)
# EMAIL_LOGO_URL=https://www.projectevil.it/html/generated-image.png
#
# --- Gmail (arriva nella casella reale) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=tua-email@gmail.com
# SMTP_PASS=password_app_16_caratteri
# SMTP_FROM_EMAIL=tua-email@gmail.com
# SMTP_SECURE=true
# SMTP_MODE=live
#
EMAIL_DEV_OUTBOX=1
EMAIL_OUTBOX_DIR=./data/email-outbox

# === Option 2: GMAIL ===
# 1. Enable 2FA on your Gmail account
# 2. Generate App Password at https://myaccount.google.com/apppasswords
# 3. Use app password instead of regular password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM_EMAIL=your-email@gmail.com
# SMTP_SECURE=true

# === Option 3: SendGrid ===
# 1. Sign up at https://sendgrid.com
# 2. Create API key from Settings > API Keys
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your_sendgrid_api_key
# SMTP_FROM_EMAIL=your-email@example.com
# SMTP_SECURE=false

# === Option 4: Generic SMTP Server ===
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_USER=your_username
# SMTP_PASS=your_password
# SMTP_FROM_EMAIL=noreply@your-domain.com
# SMTP_SECURE=false

# ==================== LOGGING ====================
LOG_LEVEL=info
LOG_FILE=./logs/app.log
AUDIT_LOG_FILE=./logs/audit.log

# ==================== PRODUCTION — GitHub + Render + projectevil.it ====================
# NODE_ENV=production
# BASE_URL=https://projectevil.it
# (se BASE_URL è vuoto, Render usa RENDER_EXTERNAL_URL automaticamente)
# DATA_DIR=/tmp/evil-data
# TRUST_PROXY=1
# FORCE_HTTPS=1
# COOKIE_DOMAIN=.projectevil.it
# EMAIL_DEV_OUTBOX=1
# REGISTER_SMTP_TIMEOUT_MS=12000
#
# --- Mailtrap SANDBOX (test: email solo su https://mailtrap.io/sandboxes) ---
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=587
# SMTP_USER=<Integration SMTP → Username della Sandbox>
# SMTP_PASS=<Integration SMTP → Password della Sandbox>
# SMTP_FROM_EMAIL=noreply@projectevil.it
# SMTP_SECURE=false
# SMTP_MODE=sandbox
#
# --- Mailtrap SENDING / dominio verificato (arriva in casella reale) ---
# SMTP_HOST=live.smtp.mailtrap.io
# SMTP_PORT=587
# SMTP_USER=<API token Sending>
# SMTP_PASS=<stesso API token>
# SMTP_FROM_EMAIL=noreply@projectevil.it
# SMTP_SECURE=false
# SMTP_MODE=live
#
# Diagnostica dopo deploy: https://projectevil.it/api/health/smtp
#
# JWT_SECRET=<genera con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))">
# JWT_SECRET_REFRESH=<altro segreto lungo e unico>

# ==================== API RATE LIMITING ====================
RATE_LIMIT_WINDOW_MS=900000   # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# ==================== CORS ====================
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,https://www.projectevil.it,https://projectevil.it

# ==================== FILE UPLOAD ====================
MAX_UPLOAD_SIZE=10485760  # 10 MB in bytes
UPLOAD_DIR=./uploads

# ==================== SECURITY FEATURES ====================
HELMET_ENABLED=true
COMPRESSION_ENABLED=true
# EVIL_TOOLS_PUBLIC=0   # default: login obbligatorio per scan/OSINT (dev e produzione)
# EVIL_TOOLS_PUBLIC=1   # solo per test interni — disabilita il login sugli strumenti

# ==================== ADMIN ====================
ADMIN_EMAIL=admin@evil-platform.com
ADMIN_PASSWORD=change_this_secure_password
