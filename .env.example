# ==================== CONFIGURAZIONE EVIL ====================
# Copia questo file in .env (oppure esegui: node scripts/setup-local.js)

# ==================== SERVER ====================
# development = debug attivo (CORS aperto, stack trace, /__debug/files)
# production  = tutto chiuso. Qualunque altro valore si comporta come production.
NODE_ENV=development
PORT=5000
BASE_URL=http://localhost:5000

# ==================== ARCHIVIO UTENTI ====================
# In produzione usa Postgres: il disco di Render free è effimero e si svuota a ogni deploy/riavvio.
# Neon (https://neon.tech) ha un piano gratuito: crea un progetto e incolla qui la connection string.
# DATABASE_URL=postgres://utente:password@host/evil?sslmode=require
#
# Senza DATABASE_URL gli utenti stanno in DATA_DIR/users.json (scrittura atomica + backup .bak all'avvio).
# Va bene in locale o con un disco persistente; NON usare /tmp in produzione.
DATA_DIR=
# DB_FILE=./data/users.json
#
# Passare da file a Postgres:  DATABASE_URL=... node scripts/migrate-users-to-postgres.js

# ==================== SEGRETI JWT ====================
# Generali con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Devono essere lunghi almeno 32 caratteri e diversi tra loro.
JWT_SECRET=your_super_secret_key_change_this_in_production_minimum_32_chars
JWT_SECRET_REFRESH=your_refresh_secret_key_change_this_in_production_min_32_chars
JWT_ACCESS_EXPIRY=1h
JWT_REFRESH_EXPIRY=7d
BCRYPT_ROUNDS=12

# ==================== EMAIL ====================
# Render free blocca le porte SMTP: in produzione usa l'API HTTPS di Mailtrap.
# MAILTRAP_API_TOKEN=token_sending_mailtrap
# EMAIL_USE_MAILTRAP_API=1
# SMTP_FROM_EMAIL=noreply@projectevil.it
#
# In locale: Mailtrap Sandbox (le email arrivano solo su https://mailtrap.io/sandboxes)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=incolla_username_da_mailtrap_sandboxes
SMTP_PASS=incolla_password_da_mailtrap_sandboxes
SMTP_FROM_EMAIL=noreply@evil-platform.com
SMTP_SECURE=false
SMTP_MODE=sandbox
# Solo con NODE_ENV=development: se l'invio fallisce (o l'email non è configurata)
# il messaggio viene salvato come file HTML qui. In produzione non succede mai.
EMAIL_DEV_OUTBOX=1
EMAIL_OUTBOX_DIR=./data/email-outbox
# EMAIL_LOGO_URL=https://www.projectevil.it/assets/evil-logo-128.png

HELP_SUPPORT_EMAIL=support@projectevil.it

# ==================== REDIS (opzionale) ====================
# Serve solo per condividere i contatori dei rate limit tra più istanze.
# Senza Redis i limiti funzionano comunque, per singolo processo.
# REDIS_URL=redis://localhost:6379

# ==================== RATE LIMIT (opzionali, valori di default) ====================
# RATE_LIMIT_GLOBAL_MAX=1000        # richieste API ogni 15 min, per utente o IP
# RATE_LIMIT_LOGIN_MAX=10           # tentativi falliti per email+IP ogni 15 min
# RATE_LIMIT_LOGIN_IP_MAX=50        # tentativi falliti per IP ogni 15 min
# RATE_LIMIT_REGISTER_MAX=5         # registrazioni per IP all'ora
# RATE_LIMIT_SCAN_MAX=50            # scansioni per utente all'ora
# RATE_LIMIT_DNS_MAX=100            # DNS/WHOIS/sottodomini per utente all'ora
# RATE_LIMIT_UPLOAD_MAX=50          # file analizzati per utente al giorno
# RATE_LIMIT_HELP_MAX=5             # richieste di supporto per IP all'ora

# ==================== LOG ====================
LOG_LEVEL=info
# In produzione i log vanno su console (visibili nel pannello di Render).
# LOG_TO_FILES=1                    # scrive anche logs/*.log

# ==================== PRODUZIONE (Render + projectevil.it) ====================
# NODE_ENV=production
# BASE_URL=https://www.projectevil.it
# TRUST_PROXY=1
# FORCE_HTTPS=1
# COOKIE_DOMAIN=.projectevil.it
# DATABASE_URL=postgres://...
# DIAGNOSTICS_TOKEN=<stringa casuale lunga>   # abilita /api/health/smtp?key=... in produzione

# ==================== CORS ====================
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,https://www.projectevil.it,https://projectevil.it

# ==================== STRUMENTI ====================
# EVIL_TOOLS_PUBLIC=0   # default: login obbligatorio per scansioni e OSINT
# EVIL_TOOLS_PUBLIC=1   # solo per test interni: strumenti aperti agli ospiti
