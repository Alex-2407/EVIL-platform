{
  "name": "evil-platform",
  "version": "1.1.0",
  "description": "EVIL — piattaforma didattica di cybersecurity: laboratori simulati, quiz, simulatori e strumenti di analisi difensiva",
  "main": "js/server.js",
  "scripts": {
    "start": "node scripts/build-home-css.js && node js/server.js",
    "dev": "node scripts/build-home-css.js && node --watch-path=server --watch-path=middleware --watch-path=services --watch-path=utils js/server.js",
    "build": "node scripts/build-home-css.js",
    "build:home-css": "node scripts/build-home-css.js",
    "test": "node --test --test-concurrency=1 \"tests/*.test.js\"",
    "lint": "eslint .",
    "check:encoding": "node scripts/find-encoding-issues.js",
    "check:deploy": "node scripts/check-deployment.js",
    "verify": "node scripts/verify-services.js",
    "migrate:postgres": "node scripts/migrate-users-to-postgres.js"
  },
  "engines": {
    "node": "22.x",
    "npm": ">=10"
  },
  "keywords": [
    "cybersecurity",
    "education",
    "security-training",
    "virtual-lab",
    "quiz"
  ],
  "author": "Alessandro Branca",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Alex-2407/evil-platform.git"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "ipaddr.js": "^2.5.0",
    "joi": "^18.2.9",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.13",
    "pdfkit": "0.13.0",
    "pg": "^8.23.0",
    "winston": "^3.19.0",
    "ws": "^8.22.0"
  },
  "overrides": {
    "path-to-regexp": "0.1.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "supertest": "^7.3.0"
  }
}
